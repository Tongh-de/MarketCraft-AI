APP_ENV=development
LOG_LEVEL=INFO
GENERATION_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TIMEOUT_SECONDS=60
IMAGE_GENERATION_MODE=mock
DASHSCOPE_API_KEY=
WANX_BASE_URL=https://dashscope.aliyuncs.com/api/v1
WANX_MODEL=wan2.6-t2i
WANX_SIZE=1280*1280
WANX_POLL_INTERVAL_SECONDS=2
WANX_TIMEOUT_SECONDS=120
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=marketcraft-ai-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
RETRIEVAL_MODE=memory
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=marketcraft_brand_knowledge
PERSISTENCE_MODE=memory
DATABASE_URL=sqlite+pysqlite:///./marketcraft.db
IDEMPOTENCY_MODE=memory
REDIS_URL=redis://localhost:6379/0
IDEMPOTENCY_TTL_SECONDS=604800
POSTGRES_PASSWORD=
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
